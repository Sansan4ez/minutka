{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConversationDecision",
  "type": "object",
  "required": ["selectedProcessIds", "workDecision", "insightDecision"],
  "properties": {
    "selectedProcessIds": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "workDecision": {
      "type": "object",
      "required": ["mode", "reason"],
      "properties": {
        "mode": { "enum": ["allow", "boundary"] },
        "reason": { "type": "string" },
        "response": { "type": "string" }
      },
      "additionalProperties": false
    },
    "insightDecision": {
      "type": "object",
      "required": ["candidate", "suggestedKinds"],
      "properties": {
        "candidate": { "type": "boolean" },
        "suggestedKinds": {
          "type": "array",
          "items": {
            "enum": ["task_category", "routine_pattern", "energy_stress_marker", "automation_candidate"]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
