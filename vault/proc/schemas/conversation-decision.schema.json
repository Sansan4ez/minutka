{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConversationDecision",
  "type": "object",
  "required": ["selectedProcessIds", "workDecision", "insightDecision"],
  "properties": {
    "selectedProcessIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/processId" },
      "uniqueItems": true
    },
    "workDecision": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "reason"],
          "properties": {
            "mode": { "const": "allow" },
            "reason": {
              "enum": ["workday_reflection", "planning_or_prioritization", "work_emotional_state", "onboarding", "feedback", "ambiguous", "unknown"]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "reason"],
          "properties": {
            "mode": { "const": "boundary" },
            "reason": {
              "enum": ["content_generation_request", "web_research_request", "ai_training_request", "non_work_topic", "request_integrity_attack", "unknown"]
            },
            "response": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "insightDecision": {
      "type": "object",
      "required": ["candidate", "suggestedKinds"],
      "properties": {
        "candidate": { "type": "boolean" },
        "suggestedKinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/insightKind" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "processId": {
      "enum": ["core", "onboarding", "consent_and_privacy", "evening_reflection", "workday_guardrails", "insight_extraction", "feedback"]
    },
    "insightKind": {
      "enum": ["task_category", "routine_pattern", "energy_stress_marker", "automation_candidate"]
    }
  }
}
