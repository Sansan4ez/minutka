# LLM
# One model for all Mastra agents. Examples: openai/gpt-5.4-mini, openai/gpt-4o-mini
LLM_MODEL=openai/gpt-5.5
OPENAI_API_KEY=

# Monthly per-owner soft usage limit and model pricing used for estimated cost.
# Values are USD; the runtime stores only token counts and estimated cost, never prompts/responses.
# The current pilot uses a subscription-backed local gateway without a metered
# per-token invoice. These conservative rates are therefore a budgeting proxy.
# At the measured post-change target of <=16k input tokens/turn, $30 covers
# about 10 owner turns/day for 30 days. Recalibrate from live usage monthly.
# Prompt-cache hits are billed separately: only the uncached remainder of the
# input is charged at the full rate. When the provider reports no cache
# breakdown the whole input stays at the full rate; a hit is never assumed.
# Set the cached rate to 0 for a gateway that does not charge for hits at all.
ASSISTANT_USAGE_MONTHLY_SOFT_LIMIT_USD=30
ASSISTANT_USAGE_INPUT_USD_PER_MILLION_TOKENS=5
ASSISTANT_USAGE_CACHED_INPUT_USD_PER_MILLION_TOKENS=0.5
ASSISTANT_USAGE_OUTPUT_USD_PER_MILLION_TOKENS=30

# Durable owner-scoped artifacts. All values are bytes except timeout (ms).
# Pilot defaults: 100 MiB per object, 2/3 GiB owner soft/hard quota, and a
# 45 GiB global artifact budget. Infrastructure must provision at least the
# additional 5 GiB reserve for PostgreSQL, MinIO metadata/versioning and ops.
# Values are non-secret deployment configuration; invalid relationships fail startup.
ASSISTANT_ARTIFACT_MAXIMUM_BYTES=104857600
ASSISTANT_ARTIFACT_SAVE_TIMEOUT_MS=60000
ASSISTANT_ARTIFACT_OWNER_SOFT_QUOTA_BYTES=2147483648
ASSISTANT_ARTIFACT_OWNER_HARD_QUOTA_BYTES=3221225472
ASSISTANT_ARTIFACT_GLOBAL_HARD_QUOTA_BYTES=48318382080
ASSISTANT_ARTIFACT_INFRASTRUCTURE_RESERVE_BYTES=5368709120

# Required canonical policy snapshot used in the privacy-v6 consent text.
# Publish it over HTTPS before deployment. The URL path must include privacy-v6;
# GitHub/raw GitHub links instead must pin a full 40-character commit SHA.
# Do not use a mutable branch such as blob/main or a private/inaccessible URL.
PRIVACY_POLICY_V6_URL=

# Optional. Overrides Mastra's OpenAI provider endpoint.
# Must support the OpenAI Responses API used by the configured agents.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional text system-context budget overrides. Values are Unicode characters
# (code points). Canonical defaults live in src/application/context-budget.ts;
# leave these commented unless a deployment deliberately changes the contract.
# Invalid or mutually inconsistent overrides fail before external resources open.
# Static base/manual sections, context/context-index empty-tree sections, the
# thread-summary minimum, and the minimum recent-history projection must fit.
# ASSISTANT_CONTEXT_TOTAL_CHARACTERS=88000
# ASSISTANT_CONTEXT_RESPONSE_RESERVE_CHARACTERS=8000
# Optional per-source ceiling overrides. Canonical context-related defaults are
# 24k for /proc/context and 4k for thread_summary.
# ASSISTANT_CONTEXT_SOURCE_AGENT_MANUAL_CHARACTERS=33000
# ASSISTANT_CONTEXT_SOURCE_PROFILE_CHARACTERS=4000
# ASSISTANT_CONTEXT_SOURCE_CONTEXT_CHARACTERS=24000
# ASSISTANT_CONTEXT_SOURCE_CONTEXT_INDEX_CHARACTERS=6000
# ASSISTANT_CONTEXT_SOURCE_RECORDS_CHARACTERS=12000
# ASSISTANT_CONTEXT_SOURCE_THREAD_SUMMARY_CHARACTERS=4000
# ASSISTANT_CONTEXT_SOURCE_HISTORY_CHARACTERS=12000
# Projection overrides are optional. Defaults remain 12 context documents,
# 8k per context document, 24 records, 10 history turns, a 4k thread summary,
# and compaction batches of 10 turns with 2k per user/assistant input field.
# The cleaned 13-document pilot KB was calibrated with 5 priority documents
# pushed on every turn; the complete file index and document tools cover the rest.
# ASSISTANT_CONTEXT_DOCUMENTS=5
# ASSISTANT_CONTEXT_DOCUMENT_CHARACTERS=8000
# ASSISTANT_CONTEXT_INDEX_DEPTH=4
# ASSISTANT_CONTEXT_RECORDS=24
# ASSISTANT_CONTEXT_RECORD_CHARACTERS=1000
# ASSISTANT_CONTEXT_HISTORY_TURNS=10
# ASSISTANT_CONTEXT_HISTORY_TURN_CHARACTERS=6000
# ASSISTANT_CONTEXT_THREAD_SUMMARY_CHARACTERS=4000
# ASSISTANT_CONTEXT_THREAD_COMPACTION_TURNS=10
# ASSISTANT_CONTEXT_THREAD_COMPACTION_FIELD_CHARACTERS=2000
# Remaining projection overrides: routing input (3 turns, 4k current text, 700
# characters per turn field), insight extraction (5 turns, 2k per field), and
# record projection ceilings (20 insights, 20 feedback entries, 50 current and
# 50 recent runs).
# ASSISTANT_CONTEXT_ROUTING_TURNS=3
# ASSISTANT_CONTEXT_ROUTING_CURRENT_TEXT_CHARACTERS=4096
# ASSISTANT_CONTEXT_ROUTING_TURN_FIELD_CHARACTERS=700
# ASSISTANT_CONTEXT_INSIGHT_TURNS=5
# ASSISTANT_CONTEXT_INSIGHT_FIELD_CHARACTERS=2000
# ASSISTANT_CONTEXT_INSIGHTS=20
# ASSISTANT_CONTEXT_FEEDBACK=20
# ASSISTANT_CONTEXT_RUN_CURRENT=50
# ASSISTANT_CONTEXT_RUN_RECENT=50
# Document tools have independent logical-output and physical-I/O limits. Defaults
# are 4k per normal read, 8k maximum per read, 48k cumulative returned Unicode
# characters, 256 KiB per context document, and 2 MiB cumulative body scan per turn.
# ASSISTANT_DOCUMENT_READ_DEFAULT_CHARACTERS=4000
# ASSISTANT_DOCUMENT_READ_MAXIMUM_CHARACTERS=8000
# ASSISTANT_DOCUMENT_TURN_READ_CHARACTERS=48000
# ASSISTANT_DOCUMENT_MAXIMUM_BYTES=262144
# ASSISTANT_DOCUMENT_TURN_SCAN_BYTES=2097152
# Result-count overrides for the same tools. Defaults are 20/50 entries per
# listing, 10/20 search hits, and a 500-character snippet per hit. A default
# above its own maximum fails at startup.
# ASSISTANT_DOCUMENT_LIST_DEFAULT=20
# ASSISTANT_DOCUMENT_LIST_MAXIMUM=50
# ASSISTANT_DOCUMENT_SEARCH_DEFAULT=10
# ASSISTANT_DOCUMENT_SEARCH_MAXIMUM=20
# ASSISTANT_DOCUMENT_SEARCH_SNIPPET_CHARACTERS=500

# Speech-to-text (Telegram voice). These credentials are deliberately separate
# from OPENAI_*: STT never inherits the LLM key or endpoint. Current supported
# provider: openai (whisper-1). Leave STT_API_KEY empty to run a text-only bot.
STT_PROVIDER=openai
STT_API_KEY=
# Optional OpenAI-compatible STT endpoint. It must support POST /audio/transcriptions.
# When unset, STT explicitly uses https://api.openai.com/v1 (not OPENAI_BASE_URL).
# STT_BASE_URL=https://api.openai.com/v1

# HTTP application API (Phase 4.2). The listener is loopback-only by default.
MINUTKA_API_HOST=127.0.0.1
MINUTKA_API_PORT=8787
# Set only behind a TLS-terminating reverse proxy. When enabled, the proxy
# must be the only direct peer and must overwrite X-Forwarded-For.
# MINUTKA_API_ALLOW_NON_LOOPBACK=true
# MINUTKA_API_TRUST_PROXY=true
# Generate each credential with: openssl rand -hex 32
MINUTKA_SERVICE_TOKEN=
MINUTKA_ADMIN_TOKEN=
# employeeId:token pairs, comma-separated. Never commit real values.
# MINUTKA_EMPLOYEE_TOKENS=emp_1:<token>
# Standalone CLI target.
MINUTKA_API_URL=http://127.0.0.1:8787
MINUTKA_API_TOKEN=

# disabled (default) | polling. Polling requires TELEGRAM_BOT_TOKEN and service token.
TELEGRAM_MODE=disabled
TELEGRAM_BOT_TOKEN=
# Used by `npm run cli -- admin invite`; omit the leading @.
TELEGRAM_BOT_USERNAME=
# Required for polling. Exactly 32 random bytes encoded as base64:
# openssl rand -base64 32
INTEGRATION_ENC_KEY=

# Local PostgreSQL development/test (used by compose.yaml). Generate distinct
# random secrets, e.g. `openssl rand -hex 32`. Do not commit a populated .env.
POSTGRES_SUPERUSER_PASSWORD=
MINUTKA_DB_PASSWORD=
MINUTKA_MIGRATOR_DB_PASSWORD=

# Personal vault object storage (Phase A). `MINIO_ACCESS_KEY` and
# `MINIO_SECRET_KEY` are application credentials, separate from root credentials.
# `docker compose up minio minio-init` creates this least-privilege user, its
# bucket, and bucket versioning. Choose distinct non-empty root and app secrets.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=127.0.0.1
# Host port from `compose.yaml`; shifted off the assistant's 9000 so both local
# stacks run at once. Console is on 9003.
MINIO_PORT=9002
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=minutka
# Required only by `npm run pilot:knowledge-base:import`. Set explicitly from
# the trusted transport owner ID; the command never infers it. The import accepts
# only Markdown and preflights the complete bootstrap plan before MinIO writes.
# PILOT_USER_ID=
# Set to this user's own knowledge-base checkout; each user has a separate path.
# PILOT_KNOWLEDGE_BASE_ROOT=/path/to/knowledge_base
# PILOT_KNOWLEDGE_BASE_MAX_DOCUMENTS=1000
# PILOT_KNOWLEDGE_BASE_MAX_TOTAL_BYTES=16777216

# Application connections. The test database is deliberately separate because
# persistence tests truncate it. For local Compose use the URLs below.
# Fill these with literal URLs after choosing MINUTKA_DB_PASSWORD. The built-in
# loader intentionally does not expand ${VAR} expressions inside .env files.
# Local Compose publishes PostgreSQL on 5433, shifted off the assistant's 5432:
#   postgresql://minutka_runtime:<MINUTKA_DB_PASSWORD>@127.0.0.1:5433/minutka
#   postgresql://minutka_runtime:<MINUTKA_DB_PASSWORD>@127.0.0.1:5433/minutka_test
DATABASE_URL=
TEST_DATABASE_URL=
# Migration-owner URLs are used only by db:migrate. Runtime URLs above use the
# non-owner minutka_runtime role.
#   postgresql://minutka_migrator:<MINUTKA_MIGRATOR_DB_PASSWORD>@127.0.0.1:5433/minutka
#   postgresql://minutka_migrator:<MINUTKA_MIGRATOR_DB_PASSWORD>@127.0.0.1:5433/minutka_test
MIGRATION_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
# require | disable. Use require in pilot; disable only for local PostgreSQL.
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Optional retention for full task-confirmation proposal/outcome payloads.
# The default is seven days (604800000 ms), preserving bounded idempotent replay
# across ordinary retries/restarts. It must exceed the 15-minute confirmation TTL.
# TASK_CONFIRMATION_COMPLETED_REPLAY_RETENTION_MS=604800000

# Separate random HMAC peppers. Generate once and retain them: changing either
# one makes existing invite or Telegram identity digests unresolvable.
INVITE_CODE_PEPPER=
TELEGRAM_IDENTITY_PEPPER=

# Dev-only local bootstrap; keep empty in pilot environments. Pilot invites are
# issued with `npm run cli -- admin invite --employee <id>` without editing .env
# or restarting the runtime. Only an HMAC digest is stored in PostgreSQL.
TELEGRAM_INVITES=
