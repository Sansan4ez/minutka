# LLM
OPENAI_API_KEY=
# Optional. Overrides Mastra's OpenAI provider endpoint.
# Must support the OpenAI Responses API used by the configured agents.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Telegram durable runtime (Phase 4.1)
TELEGRAM_BOT_TOKEN=
# Persistent application storage. Telegram always uses PostgreSQL; this value is
# intentionally not read to prevent an accidental ephemeral production runtime.
DATABASE_URL=
# require | disable. Use require in pilot; disable only for local PostgreSQL.
DATABASE_SSL_MODE=require
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
# Separate random HMAC peppers. Do not commit real values or log them.
INVITE_CODE_PEPPER=
TELEGRAM_IDENTITY_PEPPER=
# Optional local-only bootstrap: employeeId:inviteCode pairs. Codes are stored as HMAC digests.
# TELEGRAM_INVITES=emp_1:invite_abc,emp_2:invite_def
