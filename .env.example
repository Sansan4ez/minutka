# LLM
# One model for all Mastra agents. Examples: openai/gpt-5.4-mini, openai/gpt-4o-mini
LLM_MODEL=openai/gpt-5.5
OPENAI_API_KEY=

# Required canonical policy snapshot used in the privacy-v2 consent text.
# Publish it over HTTPS before deployment. The URL path must include privacy-v2;
# GitHub/raw GitHub links instead must pin a full 40-character commit SHA.
# Do not use a mutable branch such as blob/main or a private/inaccessible URL.
PRIVACY_POLICY_V2_URL=

# Optional. Overrides Mastra's OpenAI provider endpoint.
# Must support the OpenAI Responses API used by the configured agents.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional text system-context budget overrides. Values are Unicode characters
# (code points). Canonical defaults live in src/application/context-budget.ts;
# leave these commented unless a deployment deliberately changes the contract.
# Invalid or mutually inconsistent overrides fail before external resources open.
# Static base/manual sections, context/context-index empty-tree sections, the
# thread-summary minimum, and the minimum recent-history projection must fit.
# ASSISTANT_CONTEXT_TOTAL_CHARACTERS=88000
# ASSISTANT_CONTEXT_RESPONSE_RESERVE_CHARACTERS=8000
# Optional per-source ceiling overrides. Canonical context-related defaults are
# 24k for /proc/context and 4k for thread_summary.
# ASSISTANT_CONTEXT_SOURCE_AGENT_MANUAL_CHARACTERS=33000
# ASSISTANT_CONTEXT_SOURCE_PROFILE_CHARACTERS=4000
# ASSISTANT_CONTEXT_SOURCE_CONTEXT_CHARACTERS=24000
# ASSISTANT_CONTEXT_SOURCE_CONTEXT_INDEX_CHARACTERS=6000
# ASSISTANT_CONTEXT_SOURCE_RECORDS_CHARACTERS=12000
# ASSISTANT_CONTEXT_SOURCE_THREAD_SUMMARY_CHARACTERS=4000
# ASSISTANT_CONTEXT_SOURCE_HISTORY_CHARACTERS=12000
# Projection overrides are optional. Defaults remain 12 context documents,
# 8k per context document, 24 records, 10 history turns, a 4k thread summary,
# and compaction batches of 10 turns with 2k per user/assistant input field.
# ASSISTANT_CONTEXT_DOCUMENTS=12
# ASSISTANT_CONTEXT_DOCUMENT_CHARACTERS=8000
# ASSISTANT_CONTEXT_INDEX_DEPTH=4
# ASSISTANT_CONTEXT_RECORDS=24
# ASSISTANT_CONTEXT_RECORD_CHARACTERS=1000
# ASSISTANT_CONTEXT_HISTORY_TURNS=10
# ASSISTANT_CONTEXT_HISTORY_TURN_CHARACTERS=6000
# ASSISTANT_CONTEXT_THREAD_SUMMARY_CHARACTERS=4000
# ASSISTANT_CONTEXT_THREAD_COMPACTION_TURNS=10
# ASSISTANT_CONTEXT_THREAD_COMPACTION_FIELD_CHARACTERS=2000
# Document tools have independent logical-output and physical-I/O limits. Defaults
# are 4k per normal read, 8k maximum per read, 48k cumulative returned Unicode
# characters, 256 KiB per context document, and 2 MiB cumulative body scan per turn.
# ASSISTANT_DOCUMENT_READ_DEFAULT_CHARACTERS=4000
# ASSISTANT_DOCUMENT_READ_MAXIMUM_CHARACTERS=8000
# ASSISTANT_DOCUMENT_TURN_READ_CHARACTERS=48000
# ASSISTANT_DOCUMENT_MAXIMUM_BYTES=262144
# ASSISTANT_DOCUMENT_TURN_SCAN_BYTES=2097152

# Speech-to-text (Telegram voice). These credentials are deliberately separate
# from OPENAI_*: STT never inherits the LLM key or endpoint. Current supported
# provider: openai (whisper-1). Leave STT_API_KEY empty to run a text-only bot.
STT_PROVIDER=openai
STT_API_KEY=
# Optional OpenAI-compatible STT endpoint. It must support POST /audio/transcriptions.
# When unset, STT explicitly uses https://api.openai.com/v1 (not OPENAI_BASE_URL).
# STT_BASE_URL=https://api.openai.com/v1

# HTTP application API (Phase 4.2). The listener is loopback-only by default.
MINUTKA_API_HOST=127.0.0.1
MINUTKA_API_PORT=8787
# Set only behind a TLS-terminating reverse proxy. When enabled, the proxy
# must be the only direct peer and must overwrite X-Forwarded-For.
# MINUTKA_API_ALLOW_NON_LOOPBACK=true
# MINUTKA_API_TRUST_PROXY=true
# Generate each credential with: openssl rand -hex 32
MINUTKA_SERVICE_TOKEN=
MINUTKA_ADMIN_TOKEN=
# employeeId:token pairs, comma-separated. Never commit real values.
# MINUTKA_EMPLOYEE_TOKENS=emp_1:<token>
# Standalone CLI target.
MINUTKA_API_URL=http://127.0.0.1:8787
MINUTKA_API_TOKEN=

# disabled (default) | polling. Polling requires TELEGRAM_BOT_TOKEN and service token.
TELEGRAM_MODE=disabled
TELEGRAM_BOT_TOKEN=

# Local PostgreSQL development/test (used by compose.yaml). Generate distinct
# random secrets, e.g. `openssl rand -hex 32`. Do not commit a populated .env.
POSTGRES_SUPERUSER_PASSWORD=
MINUTKA_DB_PASSWORD=
MINUTKA_MIGRATOR_DB_PASSWORD=

# Personal vault object storage (Phase A). `MINIO_ACCESS_KEY` and
# `MINIO_SECRET_KEY` are application credentials, separate from root credentials.
# `docker compose up minio minio-init` creates this least-privilege user, its
# bucket, and bucket versioning. Choose distinct non-empty root and app secrets.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=personal-assistant
# Required only by `npm run pilot:knowledge-base:import`. Set explicitly from
# the trusted transport owner ID; the command never infers it.
# PILOT_USER_ID=

# Application connections. The test database is deliberately separate because
# persistence tests truncate it. For local Compose use the URLs below.
# Fill these with literal URLs after choosing MINUTKA_DB_PASSWORD. The built-in
# loader intentionally does not expand ${VAR} expressions inside .env files.
DATABASE_URL=
TEST_DATABASE_URL=
# Migration-owner URLs are used only by db:migrate. Runtime URLs above use the
# non-owner minutka_runtime role.
MIGRATION_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
# require | disable. Use require in pilot; disable only for local PostgreSQL.
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Separate random HMAC peppers. Generate once and retain them: changing either
# one makes existing invite or Telegram identity digests unresolvable.
INVITE_CODE_PEPPER=
TELEGRAM_IDENTITY_PEPPER=

# Optional local-only bootstrap: employeeId:inviteCode pairs. Codes are stored as HMAC digests.
# TELEGRAM_INVITES=emp_1:invite_abc,emp_2:invite_def
