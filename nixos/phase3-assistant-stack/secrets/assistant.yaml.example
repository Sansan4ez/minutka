# Copy to assistant.yaml, preserve the existing peppers/encryption key when
# migrating a live pilot, replace every change-me value, then encrypt with sops.
assistant:
  openai_api_key: change-me
  stt_api_key: change-me
  telegram_bot_token: change-me
  minutka_service_token: change-me
  minutka_api_token: change-me
  minutka_admin_token: change-me
  integration_enc_key: change-me
  invite_code_pepper: change-me
  telegram_identity_pepper: change-me
  minio_root_user: change-me
  minio_root_password: change-me
  minio_access_key: change-me
  minio_secret_key: change-me
  postgres_superuser_password: change-me
  minutka_db_password: change-me
  minutka_migrator_db_password: change-me
  # Production URLs use the local unix socket; percent-encode /run/postgresql.
  database_url: postgresql://minutka_runtime:change-me@localhost/minutka?host=%2Frun%2Fpostgresql
  migration_database_url: postgresql://minutka_migrator:change-me@localhost/minutka?host=%2Frun%2Fpostgresql
